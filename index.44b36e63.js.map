function success(message) {
    var div = document.createElement("div");
    div.classList.add("message");
    div.textContent = message;
    document.body.appendChild(div);
}
function error(message) {
    var div = document.createElement("div");
    div.classList = "message error-message";
    div.textContent = message;
    document.body.appendChild(div);
}
